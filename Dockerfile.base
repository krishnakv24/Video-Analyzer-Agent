FROM ubuntu:24.04

LABEL org.videolens.image-kind="runtime-base"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    FRAME_DATA_DIR=/data \
    VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

# Build this dependency image separately from application releases.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates python3 python3-venv ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && install -d -o 1000 -g 1000 -m 0750 /data

COPY requirements.txt Dockerfile.base /opt/videolens/
RUN sed -i 's/\r$//' /opt/videolens/requirements.txt /opt/videolens/Dockerfile.base \
    && python -m pip install --no-cache-dir -r /opt/videolens/requirements.txt

WORKDIR /app
USER 1000:1000
