# Copy to .env and set an absolute Linux path. Create this directory before up.
# WSL example: /home/dev/videolens-data
# Ubuntu server example: /srv/videolens/data
HOST_DATA_DIR=/home/dev/videolens-data

# Match the owner of HOST_DATA_DIR: id -u and id -g in Ubuntu.
APP_UID=1000
APP_GID=1000

# 8001 leaves the existing development service on port 8000 available.
HTTP_PORT=8001
BIND_ADDRESS=127.0.0.1
VIDEOLENS_IMAGE=videolens:local
